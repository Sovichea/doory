# Scripts that run inside Linux containers or on Linux CI: a CRLF checkout makes the kernel look for an
# interpreter such as "/bin/sh\r", which does not exist.
*.sh text eol=lf
*.envsh text eol=lf

# Build files that run on Linux hosts and in containers.
Dockerfile text eol=lf
*.Dockerfile text eol=lf
Makefile text eol=lf
docker-compose*.yml text eol=lf
